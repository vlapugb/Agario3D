set(license_dir share/licenses/agario3d)
if(WIN32)
    set(game_bin .)
    set(game_data .)
    set(license_dir licenses)
    find_file(EPOXY_DLL NAMES libepoxy-0.dll epoxy-0.dll HINTS "${EPOXY_INCLUDE_DIR}/../bin" REQUIRED)
    install(FILES "$<TARGET_FILE:SDL3::SDL3-shared>" "${EPOXY_DLL}" DESTINATION .)
    install(FILES packaging/licenses/SDL3.txt packaging/licenses/libepoxy.txt DESTINATION "${license_dir}")
else()
    set(game_bin bin)
    set(game_data share/agario3d)
    install(FILES packaging/agario3d.desktop DESTINATION share/applications)
    install(FILES packaging/agario3d.svg DESTINATION share/icons/hicolor/scalable/apps)
endif()
install(TARGETS agario3d RUNTIME DESTINATION "${game_bin}")
install(FILES assets/hud.bmp DESTINATION "${game_data}")
install(FILES LICENSE assets/FONT-LICENSE.txt DESTINATION "${license_dir}")
install(FILES "${HUYNITY_SOURCE_DIR}/LICENSE" DESTINATION "${license_dir}" RENAME Huynity-LICENSE.txt)

set(CPACK_PACKAGE_NAME agario3d)
set(CPACK_PACKAGE_VENDOR "Vladimir Pugovkin")
set(CPACK_PACKAGE_CONTACT "Vladimir Pugovkin <vlapugb@users.noreply.github.com>")
set(CPACK_PACKAGE_HOMEPAGE_URL "https://github.com/vlapugb/Agario3D")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Single-player 3D cell arena game powered by Huynity")
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
set(CPACK_PACKAGE_DIRECTORY "${PROJECT_BINARY_DIR}/packages")
if(WIN32)
    set(CPACK_GENERATOR "ZIP;NSIS")
    set(CPACK_PACKAGE_FILE_NAME "Agario3D-${PROJECT_VERSION}-windows-${CMAKE_SYSTEM_PROCESSOR}")
    set(CPACK_PACKAGE_INSTALL_DIRECTORY "Agario 3D")
    set(CPACK_NSIS_DISPLAY_NAME "Agario 3D")
    set(CPACK_NSIS_EXECUTABLES_DIRECTORY ".")
    set(CPACK_PACKAGE_EXECUTABLES agario3d "Agario 3D")
else()
    set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
    set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
    set(CPACK_DEBIAN_PACKAGE_SECTION games)
    set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
    set(CPACK_RPM_FILE_NAME RPM-DEFAULT)
    set(CPACK_RPM_PACKAGE_LICENSE "MIT AND OFL-1.1")
    set(CPACK_RPM_PACKAGE_RELOCATABLE OFF)
    set(CPACK_RPM_EXCLUDE_FROM_AUTO_FILELIST_ADDITION
        /usr/share/applications /usr/share/licenses /usr/share/icons /usr/share/icons/hicolor
        /usr/share/icons/hicolor/scalable /usr/share/icons/hicolor/scalable/apps)
    if(EXISTS /etc/debian_version)
        set(CPACK_GENERATOR DEB)
    elseif(EXISTS /etc/redhat-release)
        set(CPACK_GENERATOR RPM)
    endif()
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND TARGET SDL3::SDL3-shared)
        add_custom_target(package-portable
            COMMAND "${PROJECT_SOURCE_DIR}/packaging/portable.sh" "${PROJECT_BINARY_DIR}"
                    "Agario3D-${PROJECT_VERSION}-linux-${CMAKE_SYSTEM_PROCESSOR}" "$<TARGET_FILE:SDL3::SDL3-shared>"
            DEPENDS agario3d VERBATIM)
    endif()
endif()
include(CPack)
